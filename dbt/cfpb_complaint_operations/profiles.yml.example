# Copy to .dbt/profiles.yml (which is ignored) or to ~/.dbt/profiles.yml.
# Uses only environment variables; do not commit account credentials.
cfpb_complaint_operations:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      authenticator: "{{ env_var('SNOWFLAKE_AUTHENTICATOR', 'snowflake') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD', '') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'CFPB_PORTFOLIO_ROLE') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE', 'CFPB_PORTFOLIO_WH') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE', 'CFPB_ANALYTICS') }}"
      schema: ANALYTICS
      threads: 4
      client_session_keep_alive: false
