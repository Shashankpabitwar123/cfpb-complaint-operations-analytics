# Copy this file to .env locally. Do not commit .env or paste credentials into chat.
# External-browser authentication is recommended for a portfolio project.
SNOWFLAKE_ACCOUNT=your_organization-your_account_locator
SNOWFLAKE_USER=your_snowflake_username
# First bootstrap only: set this to ACCOUNTADMIN. After the setup/load succeeds,
# change it back to CFPB_PORTFOLIO_ROLE for dbt and analysis execution.
SNOWFLAKE_ROLE=CFPB_PORTFOLIO_ROLE
SNOWFLAKE_WAREHOUSE=CFPB_PORTFOLIO_WH
SNOWFLAKE_DATABASE=CFPB_ANALYTICS
SNOWFLAKE_AUTHENTICATOR=externalbrowser

# Only use a password if your organization requires it; leave unset otherwise.
# SNOWFLAKE_PASSWORD=
